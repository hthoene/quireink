# The tools a release of the app is built with, everywhere (the release
# workflow, F-Droid), so it comes out byte for byte the same: F-Droid then
# publishes the app signed with QuireInk's key. build-apk.sh uses them when
# installed, and requires them with QUIREINK_REPRODUCIBLE=1.
RUST_VERSION=1.99.0
NDK_VERSION=28.2.13676358
BUILD_TOOLS_VERSION=36.0.0
PLATFORM_VERSION=35
CARGO_NDK_VERSION=4.1.2
JDK_VERSION=21
