<?xml version="1.0" encoding="utf-8"?>
<!-- QuireInk for Android: a native activity; its only Java code is the
     speech listener (classes.dex). The version is the workspace's
     (Cargo.toml), its code 1.2.3 → 10203; build-apk.sh checks both. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.hthoene.quireink"
    android:versionCode="300"
    android:versionName="0.3.0">

    <!-- The shared Books folder: "All files access" from Android 11 on, the
         storage permission before. Asked for only when the user chooses
         "Use the Books folder" on the home screen. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Plugins that sync (e.g. reading progress with KOReader). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Reading aloud: the system's speech engines must be visible. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- extractNativeLibs false: the library is stored in the APK, aligned,
         and runs from there. usesCleartextTraffic: self-hosted sync servers often answer over
         plain http in the home network. -->
    <application
        android:label="QuireInk"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale">
            <meta-data
                android:name="android.app.lib_name"
                android:value="quireink" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
